{
  "idle_hours": {
    "description": "空闲多少小时后考虑发",
    "type": "float",
    "default": 2.0,
    "slider": { "min": 0.5, "max": 24, "step": 0.5 },
    "hint": "用户超过这么久没说话，才可能触发一条主动消息。"
  },
  "cooldown_hours": {
    "description": "两条主动消息的最小间隔（小时）",
    "type": "float",
    "default": 3.0,
    "slider": { "min": 0.5, "max": 48, "step": 0.5 }
  },
  "daily_max": {
    "description": "每天最多发几条",
    "type": "int",
    "default": 5,
    "slider": { "min": 1, "max": 20, "step": 1 }
  },
  "active_from": {
    "description": "允许主动的起始小时",
    "type": "int",
    "default": 8,
    "slider": { "min": 0, "max": 23, "step": 1 },
    "hint": "24 小时制，含起始小时。"
  },
  "active_to": {
    "description": "允许主动的结束小时",
    "type": "int",
    "default": 23,
    "slider": { "min": 1, "max": 24, "step": 1 },
    "hint": "24 小时制，不含结束小时。"
  },
  "check_every": {
    "description": "轮询间隔（秒）",
    "type": "int",
    "default": 300,
    "slider": { "min": 60, "max": 3600, "step": 60 }
  },
  "max_seg": {
    "description": "一条主动消息最多分几段发",
    "type": "int",
    "default": 3,
    "slider": { "min": 1, "max": 6, "step": 1 }
  },
  "seg_gap_min": {
    "description": "分段间隔下限（秒）",
    "type": "float",
    "default": 6.0,
    "slider": { "min": 1, "max": 60, "step": 1 }
  },
  "seg_gap_max": {
    "description": "分段间隔上限（秒）",
    "type": "float",
    "default": 12.0,
    "slider": { "min": 1, "max": 120, "step": 1 }
  }
}
